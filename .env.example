# ============================================
# FixPilot — Environment Configuration
# ============================================

# --- LiteLLM (Cloud LLM - Claude) ---
LITELLM_API_KEY=your_litellm_api_key_here
LITELLM_BASE_URL=https://api.anthropic.com/v1
LITELLM_MODEL=claude-sonnet-4-20250514

# --- neatlogs (Observability & Tracing) ---
NEATLOGS_API_KEY=your_neatlogs_project_key
NEATLOGS_PROJECT_ID=your_neatlogs_project_id
NEATLOGS_WORKFLOW_NAME=fixpilot

# --- GitHub (Issues & Pull Requests) ---
GITHUB_TOKEN=your_github_token_here

# --- Entire (Codebase Context) ---
ENTIRE_API_KEY=your_entire_api_key_here

# --- Local LLM (Guardrails - Llama 4-bit) ---
LOCAL_MODEL_PATH=models/llama-3.2-3b-q4_k_m.gguf
LOCAL_MODEL_CONTEXT_LENGTH=4096

# --- cfo.ai (Unit Economics & Margin Modeling) ---
CFO_AI_API_KEY=your_cfo_ai_api_key_here
